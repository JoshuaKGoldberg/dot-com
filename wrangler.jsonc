{
	"$schema": "node_modules/wrangler/config-schema.json",
	"assets": {
		"directory": "dist",
	},
	"compatibility_date": "2026-11-18",
	"main": "worker/index.ts",
	"name": "dot-com",
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "joshuakgoldberg-files",
		},
	],
	"routes": [
		{
			"custom_domain": true,
			"pattern": "www.joshuakgoldberg.com",
		},
	],
	"workers_dev": true,
}
