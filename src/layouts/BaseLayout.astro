---
import { SkipLink } from "accessible-astro-components";

import Footer from "~/components/Footer.astro";
import Head from "~/components/Head.astro";
import Header from "~/components/Header.astro";
import MainArea from "~/components/MainArea.astro";
import Scenery from "~/components/scenery/Scenery.astro";

import "./normalize.css";
import "./base.css";

interface Props {
	class?: string | undefined;
	description: string;

	/** Whether to spread out or squeeze in to the screen, scrolling only if it can't. */
	fitsScreen?: boolean;

	image: string;
	title?: string;
}

const { class: className, description, fitsScreen, image, title } = Astro.props;
---

<html lang="en">
	<Head description={description} image={image} title={title} />
	<script>
		document.body.classList.add("javascriptEnabled");
	</script>
	<div id="#top"></div>
	<MainArea as="body" class={className} data-fits-screen={fitsScreen}>
		<SkipLink />
		<Header />

		<div class="content" data-content>
			<main id="main-content">
				<slot />
			</main>
			<Footer />
		</div>

		<script data-astro-rerun is:inline>
			// Eases images in once they're ready, instead of them suddenly appearing
			for (const element of document.querySelectorAll("[data-reveal]")) {
				const reveal = () => {
					element.dataset.reveal = "ready";
				};

				element.querySelector("img").decode().then(reveal, reveal);
			}
		</script>
		<Scenery />
	</MainArea>
</html>

<script>
	const getContentTop = () =>
		document.querySelector("[data-content]")?.getBoundingClientRect().top ?? 0;

	let previousTop = 0;

	// Keeps the previous page from seeming to scroll as it fades out
	document.addEventListener("astro:before-swap", () => {
		previousTop = getContentTop();
	});
	document.addEventListener("astro:after-swap", () => {
		const shift = previousTop - getContentTop();

		document.documentElement.style.setProperty(
			"--contentShift",
			`${shift.toString()}px`,
		);
	});
</script>

<style>
	.content {
		view-transition-name: content;
	}

	[data-fits-screen],
	[data-fits-screen] .content {
		display: flex;
		flex-direction: column;
	}

	[data-fits-screen] .content {
		flex: 1 0 auto;
	}

	/* Whatever height is left is shared with the footer, then mostly above the hero */
	[data-fits-screen] main {
		display: grid;
		flex: 1.5 0 auto;
		grid-template: 2fr auto 1fr auto / minmax(0, 1fr);
	}
</style>
