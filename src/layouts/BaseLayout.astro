---
import { SkipLink } from "accessible-astro-components";

import Footer from "~/components/Footer.astro";
import Head from "~/components/Head.astro";
import Header from "~/components/Header.astro";
import MainArea from "~/components/MainArea.astro";
import Scenery from "~/components/scenery/Scenery.astro";

import "./normalize.css";
import "./base.css";

interface Props {
	class?: string | undefined;
	description: string;

	/** Whether to spread out or squeeze in to the screen, scrolling only if it can't. */
	fitsScreen?: boolean;

	image: string;
	title?: string;
}

const { class: className, description, fitsScreen, image, title } = Astro.props;
---

<html lang="en">
	<Head description={description} image={image} title={title} />
	<script>
		document.body.classList.add("javascriptEnabled");
	</script>
	<div id="#top"></div>
	<MainArea as="body" class={className} data-fits-screen={fitsScreen}>
		<SkipLink />
		<Header />

		<div class="content" data-content>
			<main id="main-content">
				<slot />
			</main>
			<Footer />
		</div>

		<Scenery />
	</MainArea>
</html>

<script>
	import { decodePortrait } from "~/transitions/decodePortrait";
	import { shiftTones } from "~/transitions/shiftTones";

	document.addEventListener("astro:before-preparation", (event) => {
		const load = event.loader;

		event.loader = async () => {
			await load();
			await decodePortrait(event.newDocument);
		};
	});

	const getContentTop = () =>
		document.querySelector("[data-content]")?.getBoundingClientRect().top ?? 0;

	let previousTop = 0;

	// Keeps the previous page from seeming to scroll as it fades out
	document.addEventListener("astro:before-swap", (event) => {
		previousTop = getContentTop();
		shiftTones(document, event.newDocument, event.viewTransition);

		// Swapping to a page whose root was missing any, such as its theme, would keep
		// the elements that stay between pages from transitioning to their new states
		for (const { name, value } of document.documentElement.attributes) {
			if (!event.newDocument.documentElement.hasAttribute(name)) {
				event.newDocument.documentElement.setAttribute(name, value);
			}
		}
	});
	document.addEventListener("astro:after-swap", () => {
		const shift = previousTop - getContentTop();

		document.documentElement.style.setProperty(
			"--contentShift",
			`${shift.toString()}px`,
		);
	});
</script>

<style>
	.content {
		view-transition-name: content;
	}

	[data-fits-screen],
	[data-fits-screen] .content {
		display: flex;
		flex-direction: column;
	}

	[data-fits-screen] .content {
		flex: 1 0 auto;
	}

	/* Whatever height is left is shared with the footer, then mostly above the hero */
	@media (min-width: 700px) {
		[data-fits-screen] main {
			display: grid;
			flex: 1.1 0 auto;
			grid-template: 1.6fr auto 1fr auto / minmax(0, 1fr);
		}
	}
</style>
