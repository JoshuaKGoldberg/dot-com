---
import Hero from "~/components/Hero.astro";
import HeroSecondary from "~/components/HeroSecondary.astro";
import { siteName } from "~/constants";
import { type PortraitName, portraits } from "~/portraits";

import BaseLayout from "./BaseLayout.astro";

interface Props {
	class?: string | undefined;
	description: string;
	fitsScreen?: boolean;
	portrait: PortraitName;
	primary: string;
	title?: string;
}

const { description, portrait, primary, title } = Astro.props;
---

<BaseLayout
	class={Astro.props.class}
	description={description}
	fitsScreen={Astro.props.fitsScreen}
	preview={{
		alt: `${title ?? siteName}: ${portraits[portrait].alt}`,
		name: portrait,
	}}
	shortTitle={title ?? siteName}
	title={title ? `${title} | ${siteName}` : siteName}
>
	<Hero
		isLarge={Astro.props.fitsScreen}
		portrait={portraits[portrait]}
		primary={primary}
	>
		<HeroSecondary>
			<slot name="secondary" />
		</HeroSecondary>
		<slot name="tertiary" />
	</Hero>
	<slot />
</BaseLayout>
