---
import type { HeroPortraitImages } from "~/components/hero/HeroPortrait.astro";

import Hero from "~/components/Hero.astro";
import HeroSecondary from "~/components/HeroSecondary.astro";

import BaseLayout from "./BaseLayout.astro";

interface Props {
	alt: string;
	class?: string | undefined;
	description: string;
	fitsScreen?: boolean;
	portrait: HeroPortraitImages;
	preview?: string;
	primary: string;
	size?: "large" | "medium";
	slug?: string;
	title?: string;
}

const {
	description,
	preview,
	primary,
	size,
	slug = primary.toLowerCase(),
	title,
} = Astro.props;
---

<BaseLayout
	{...Astro.props}
	description={description}
	image={preview ?? `images/${slug}.png`}
	title={title ? `${title} | Josh Goldberg` : "Josh Goldberg"}
>
	<Hero
		alt={Astro.props.alt}
		portrait={Astro.props.portrait}
		primary={primary}
		size={size}
	>
		<HeroSecondary>
			<slot name="secondary" />
		</HeroSecondary>
		<slot name="tertiary" />
	</Hero>
	<slot />
</BaseLayout>
