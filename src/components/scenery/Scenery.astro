---
import AuroraBand from "./AuroraBand.astro";
---

<squiggle-overlay
	aria-hidden="true"
	class="squiggles"
	transition:persist="squiggles"
></squiggle-overlay>
<div aria-hidden="true" class="scenery" transition:persist="scenery">
	<AuroraBand edge="top" />
	<AuroraBand edge="bottom" />
	<star-field class="stars"></star-field>
</div>

<script>
	// Everything looks complete without this: it only adds what happens on approach
	const whenIdle = globalThis.requestIdleCallback ?? setTimeout;

	whenIdle(() => {
		void import("~/scenery");
	});
</script>

<style>
	.scenery {
		contain: strict;
		inset: 0;
		pointer-events: none;
		position: fixed;
		z-index: -1;
	}

	.stars {
		inset: 0;
		position: absolute;
	}

	.stars :global(canvas) {
		display: block;
		height: 100%;
		width: 100%;
	}

	/* Scrolls along with the page, and has no size of its own to get in its way */
	.squiggles {
		left: 0;
		pointer-events: none;
		position: absolute;
		top: 0;
	}

	.squiggles :global(svg) {
		left: 0;
		overflow: visible;
		position: absolute;
		top: 0;
		transition: var(--transitionSlow) filter;
	}

	.squiggles :global([data-hovered]) {
		filter: var(--squiggleVivid);
		transition: var(--transitionVivid);

		/* Squiggles that are first drawn while already hovered fade up too */
		@starting-style {
			filter: saturate(1) brightness(1);
		}
	}

	@media (forced-colors: active) {
		.squiggles {
			display: none;
		}
	}

	@media print {
		.scenery,
		.squiggles {
			display: none;
		}
	}
</style>
