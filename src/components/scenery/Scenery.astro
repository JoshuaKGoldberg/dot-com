---
import AuroraBand from "./AuroraBand.astro";
---

<squiggle-overlay
	aria-hidden="true"
	class="squiggles"
	transition:persist="squiggles"
></squiggle-overlay>
<div aria-hidden="true" class="scenery" transition:persist="scenery">
	<AuroraBand edge="top" />
	<AuroraBand edge="bottom" />
	<star-field class="stars"></star-field>
</div>
<aside
	aria-label="Goldberg snarks"
	class="labels"
	data-snark-labels
	transition:persist="snark-labels"
></aside>

<script>
	// Only adds what happens on approach
	const whenIdle = globalThis.requestIdleCallback ?? setTimeout;

	whenIdle(() => {
		void import("~/scenery");
	});
</script>

<style>
	.scenery {
		contain: strict;
		inset: 0;
		pointer-events: none;
		position: fixed;
		z-index: -1;
	}

	/* Stays the same size as mobile browsers' bars come and go */
	.stars {
		height: 100lvh;
		left: 0;
		position: absolute;
		top: 0;
		width: 100%;
	}

	.stars :global(canvas) {
		display: block;
		height: 100%;
		width: 100%;
	}

	.labels {
		inset: 0;
		overflow: clip;
		pointer-events: none;
		position: fixed;
	}

	.labels:empty {
		display: none;
	}

	.labels :global(a) {
		/* The smallest that links' areas can be is 24px, however small their text is */
		--padding: 7px;

		-webkit-font-smoothing: antialiased;
		box-sizing: border-box;
		color: var(--colorFaint);
		font-family: var(--fontLabel);
		font-size: 0.5625rem;
		font-weight: 400;
		left: 0;
		letter-spacing: 0.11em;
		line-height: 10px;
		padding: var(--padding) 8px;
		pointer-events: auto;
		position: absolute;
		text-align: center;
		text-transform: uppercase;
		text-wrap: balance;
		top: calc(-1 * var(--padding));
		width: max-content;
	}

	/* Covers whatever's painted behind the text, which could make it less readable */
	.labels :global(a)::before {
		background: var(--colorBackground);
		border-radius: 8px;
		content: "";
		filter: blur(3px);
		inset: 1px -2px;
		position: absolute;
		z-index: -1;
	}

	.labels :global(a:is(:hover, :focus-visible)) {
		color: var(--colorForeground);
	}

	/* Scrolls along with the page, and has no size of its own to get in its way */
	.squiggles {
		left: 0;
		pointer-events: none;
		position: absolute;
		top: 0;
	}

	.squiggles :global(svg) {
		left: 0;
		overflow: visible;
		position: absolute;
		top: 0;
		transition: var(--transitionSlow) filter;
	}

	.squiggles :global([data-hovered]) {
		filter: var(--squiggleVivid);
		transition: var(--transitionVivid);

		/* Squiggles that are first drawn while already hovered fade up too */
		@starting-style {
			filter: saturate(1) brightness(1);
		}
	}

	@media print, (forced-colors: active) {
		.labels,
		.scenery,
		.squiggles {
			display: none;
		}
	}
</style>
