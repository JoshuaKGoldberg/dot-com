---
import { Anchor } from "./Anchor";
import { EmojiBlastHeart } from "./EmojiBlastHeart";
import { Text } from "./Text";
---

<footer>
	<Text as="p" class="credit" font="label" fontSize="smallest">
		Made with <EmojiBlastHeart client:visible /> in Boston using Astro, Solid,
		and TypeScript.
		<span aria-hidden="true" class="dot">
			·
		</span>
		<Anchor href="https://github.com/JoshuaKGoldberg/dot-com" target="_blank">
			view source
		</Anchor>
	</Text>
</footer>

<style>
	footer {
		padding: clamp(4rem, 14vh, 9rem) var(--widthPagePadding)
			clamp(4rem, 13vh, 7.5rem);
		text-align: center;
		width: 100%;
	}

	.credit {
		--squiggleOffset: -0.55em;

		letter-spacing: 0.06em;
		line-height: 1.8;
		text-wrap: balance;
	}

	.dot {
		padding: 0 0.55em;
	}

	/* Rises into view as it's scrolled to */
	@supports (animation-timeline: view()) {
		.credit {
			--fadeEnd: 6%;

			animation: emerge linear both;
			/* Without a var(), minifying merges the timeline into the shorthand */
			animation-range: entry 0% cover var(--fadeEnd);
			animation-timeline: view();
		}

		:global(html[data-motion="paused"]) .credit {
			animation: none;
		}
	}

	@keyframes emerge {
		from {
			opacity: 0;
			translate: 0 18px;
		}
	}
</style>
