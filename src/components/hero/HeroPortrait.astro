---
import type { ImageMetadata } from "astro";

import { Image } from "astro:assets";

import { getTone } from "./getTone";
import GlassRing from "./GlassRing.astro";

export interface HeroPortraitImages {
	/** Blurred silhouette of the cutout, used only for its alpha */
	halo: ImageMetadata;

	/** Person cut out from their photo, with extra pixels below the circle, and maybe above it */
	image: ImageMetadata;

	/** What's behind them in their photo, for the same area as the circle */
	scene?: ImageMetadata;
}

interface Props extends HeroPortraitImages {
	alt: string;
}

const { alt, halo, image, scene } = Astro.props;

/** Height, relative to its width, of a cutout that starts at the top of the circle. */
const usualHeight = 544 / 512;

/** Which way each of the hues of light from behind the person moves as they split apart. */
const haloSides = [-1, 0, 1];

const overhang = image.height / image.width - usualHeight;
---

<hero-portrait class="portrait">
	<div
		aria-hidden="true"
		class="backdrop"
		data-layer="backdrop"
		data-tone={scene && (await getTone(scene))}
	>
		<div class="aurora resting"></div>
		{scene && (
			<div class="scene">
				<Image
					alt=""
					class="scene-image"
					densities={[1, 2]}
					loading="eager"
					src={scene}
					width={256}
				/>
			</div>
		)}
		<div
			class:list={["aurora awake", scene && "vivid"]}
			data-portrait="light"
		></div>
	</div>
	<div aria-hidden="true" class="constellation" data-portrait="sky"></div>
	<GlassRing />
	<GlassRing awake data-portrait="light" />
	<div class="clip" data-layer="figure" data-tone={await getTone(image)}>
		<div class="figure" data-portrait="figure">
			<div aria-hidden="true" class="glow" data-portrait="glow">
				{haloSides.map((side) => (
					<div
						class="halo"
						data-portrait="halo"
						data-side={side}
						style={{ "--halo": `url("${halo.src}")`, "--side": side }}
					>
						<div class="halo-colors" />
					</div>
				))}
			</div>
			<Image
				alt={alt}
				class="cutout"
				densities={[1, 2]}
				fetchpriority="high"
				loading="eager"
				quality="high"
				src={image}
				style={{ "--overhang": `${(overhang * 100).toFixed(3)}%` }}
				width={256}
			/>
		</div>
	</div>
</hero-portrait>

<style>
	.portrait {
		--size: calc(var(--heroSizeLarge) * var(--heroScale, 1));

		view-transition-name: portrait;
		display: block;
		height: var(--size);
		position: relative;
		user-select: none;
		width: var(--size);
	}

	.backdrop,
	.clip,
	.constellation {
		inset: 0;
		position: absolute;
	}

	.backdrop {
		background: var(--discMiddle)
			linear-gradient(var(--discTop), var(--discMiddle) 60%, var(--discBottom));
		border-radius: 50%;
		box-shadow: 0 0 2rem 0.5rem var(--discGlow);
		contain: paint;
		overflow: hidden;
	}

	/* What was really behind them, with them removed from it */
	.scene {
		inset: 0;
		position: absolute;
	}

	.scene-image {
		display: block;
		height: auto;
		mask: linear-gradient(
			to right,
			rgb(0 0 0 / 70%),
			rgb(0 0 0 / 90%),
			rgb(0 0 0 / 70%)
		);
		width: 100%;
	}

	/* Curtains of light hanging from the top of the circle */
	.aurora,
	.aurora::after,
	.aurora::before {
		inset: 0;
		position: absolute;
	}

	.aurora::after,
	.aurora::before {
		background:
			radial-gradient(
				ellipse 24% 46% at 16% 40%,
				var(--curtainJade),
				transparent
			),
			radial-gradient(
				ellipse 26% 52% at 42% 32%,
				var(--curtainCornflower),
				transparent
			),
			radial-gradient(
				ellipse 24% 48% at 68% 42%,
				var(--curtainWisteria),
				transparent
			),
			radial-gradient(
				ellipse 22% 44% at 92% 36%,
				var(--curtainRose),
				transparent
			);
		content: "";
		inset: -20% -40%;
		opacity: var(--front, 0.6);
	}

	.aurora::after {
		opacity: var(--back, 0.4);
		transform: scaleX(-1) translateY(12%);
	}

	.resting {
		filter: saturate(var(--curtainSaturation));
		opacity: var(--curtainStrength);
	}

	.awake,
	.glow {
		opacity: 0;
	}

	/* Photos can be dark in either theme, so light over them is always strong */
	.vivid {
		--curtainJade: rgb(56 255 153);
		--curtainCornflower: rgb(51 191 255);
		--curtainWisteria: rgb(173 115 255);
		--curtainRose: rgb(255 102 158);
		--back: 0.6;
		--front: 0.85;

		mix-blend-mode: screen;
	}

	/* Kept on their own layers, so that they're never repainted as they change */
	.awake,
	.figure,
	.glow,
	.halo {
		will-change: opacity, transform;
	}

	/* Light from behind the person, whose hues come apart in the pointer's direction */
	.glow {
		inset: 0;
		position: absolute;
	}

	.halo {
		aspect-ratio: 1;
		left: -21.875%;
		mask: var(--halo) center / 100% 100% no-repeat;
		opacity: var(--haloStrength);
		position: absolute;
		top: calc(-0.21875 * var(--size));
		width: 143.75%;
	}

	.halo-colors {
		background: conic-gradient(
			var(--ringJade),
			var(--ringCornflower),
			var(--ringWisteria),
			var(--ringRose),
			var(--ringWisteria),
			var(--ringCornflower),
			var(--ringJade)
		);
		border-radius: 50%;
		inset: -25%;
		position: absolute;
	}

	/* Fades out before it could reach the text beside the portrait */
	.constellation {
		inset: -21.875%;
		mask: radial-gradient(closest-side, black 80%, transparent);
	}

	.constellation :global(canvas) {
		display: block;
		height: 100%;
		width: 100%;
	}

	/*
	 * Open at the top for anything taller than the circle, and round at the bottom,
	 * where 50% is of the circle itself: so that nothing ever covers the ring.
	 */
	.clip {
		view-transition-name: portrait-figure;
		clip-path: inset(-25% 0 0 0 round 0 0 50% 50%);
	}

	.figure {
		display: flow-root;
		position: relative;
	}

	.cutout {
		display: block;
		height: auto;
		margin-top: calc(-1 * var(--overhang));
		position: relative;
		width: 100%;
	}

	.portrait[data-awake] .awake::before {
		animation: drift 40s ease-in-out infinite alternate;
	}

	.portrait[data-awake] .awake::after {
		animation: drift-back 52s ease-in-out infinite alternate;
	}

	.portrait[data-awake] .halo-colors {
		animation: turn 48s linear calc(var(--side) * 16s - 16s) infinite;
	}

	@keyframes drift {
		to {
			transform: translateX(14%);
		}
	}

	@keyframes drift-back {
		to {
			transform: scaleX(-1) translate(12%, 12%);
		}
	}

	@keyframes turn {
		to {
			transform: rotate(1turn);
		}
	}

	@media print {
		.constellation,
		.halo {
			display: none;
		}
	}
</style>
