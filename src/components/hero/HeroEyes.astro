---
import irises from "~/assets/heroes/home-irises.webp";
import whites from "~/assets/heroes/home-eye-whites.webp";

// Everything here is in the 512px-wide coordinates of home.webp
const openings = [
	"242.3,221 243.9,219.5 245.7,217.9 248.9,216.3 254,215.5 258.9,216.1 263.9,218.4 268,221.2 269.8,222.8 268.3,223.2 265,223.3 260.6,224 256,224.6 251.1,224.7 247.5,223.9 244.9,222.8",
	"298.3,224.7 299.8,222.9 302.9,220.4 307.6,218.6 312.5,218.3 316.7,219.3 319.2,221 320.5,222.5 321.3,223.8 320,225.3 318.5,226.1 316.1,226.7 312.1,226.9 307.3,226.5 302.9,225.7 299.9,225.2",
];

const patch = { height: 26, width: 96, x: 234, y: 206 };
---

<svg aria-hidden="true" class="eyes" data-portrait="eyes" viewBox="0 0 512 544">
	{openings.map((points, index) => (
		<>
			<clipPath id={`eye-${index}`}>
				<polygon points={points} />
			</clipPath>
			<g clip-path={`url(#eye-${index})`}>
				<image {...patch} href={whites.src} />
				<image {...patch} data-iris href={irises.src} />
			</g>
		</>
	))}
</svg>

<style>
	/* The cutout already has eyes: these only show once both images are decoded */
	.eyes {
		height: 100%;
		inset: 0;
		pointer-events: none;
		position: absolute;
		visibility: hidden;
		width: 100%;
	}

	.eyes[data-ready] {
		visibility: visible;
	}
</style>
