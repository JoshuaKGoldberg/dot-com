---
import { Text } from "~/components/Text";

interface Props {
	size?: "normal" | "wide";
}
---

<Text
	as="p"
	class:list={["secondary", Astro.props.size ?? "normal"]}
	fontSize="subtitle"
>
	<slot />
</Text>

<style>
	.secondary {
		font-size: var(--heroSecondarySize, var(--fontSizeSubtitle));
		line-height: 1.2;
		text-wrap: balance;
		margin: 0.75rem 0 clamp(1rem, 4vh, 2rem);
	}

	.secondary.normal {
		max-width: calc(23rem * var(--heroScale, 1));
	}

	@media (min-width: 700px) {
		.secondary {
			margin: 0.5rem 0 0;
		}
	}
</style>
