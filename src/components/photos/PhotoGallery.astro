---
import { Image } from "astro:assets";

import { getPhotoUrl, type Photo } from "~/photos";

import { Anchor } from "../Anchor";
import { Text } from "../Text";

interface Props {
	photos: Photo[];
}

/** Images near enough the top to show before any scrolling. */
const eagerCount = 3;

/**
 * How wide each lane is, matching the gallery's CSS:
 * three once there's room for 15rem lanes, then two, then one.
 */
const sizes = [
	"(width >= 63.5625em) 20rem",
	"(width >= 51rem) calc((100vw - 6rem) / 3)",
	"(width >= 35rem) calc((100vw - 5rem) / 2)",
	"calc(100vw - 1rem)",
].join(", ");

const widths = [320, 480, 640, 960, 1280];

const displayWidth = 640;

/** Formats a timestamp's calendar date, as it was wherever the photo was taken. */
function formatDate(timestamp: string) {
	return new Date(timestamp.slice(0, 10)).toLocaleString("en-US", {
		day: "numeric",
		month: "long",
		timeZone: "GMT",
		year: "numeric",
	});
}
---

<ul class="gallery">
	{Astro.props.photos.map((photo, index) => (
		<li class="item">
			<details class="details">
				<summary class="summary">
					<Image
						alt={photo.alt}
						class="image"
						format="avif"
						height={Math.round(
							(Math.min(displayWidth, photo.width) * photo.height) /
								photo.width,
						)}
						loading={index < eagerCount ? "eager" : "lazy"}
						quality={60}
						sizes={sizes}
						src={getPhotoUrl(photo)}
						width={Math.min(displayWidth, photo.width)}
						widths={widths.filter((width) => width <= photo.width)}
					/>
				</summary>
				<Text
					as="p"
					class="caption"
					font="label"
					fontSize="smaller"
					tone="muted"
				>
					<span class="event">{photo.event}</span>{" "}
					<span aria-hidden="true" class="dot">
						·
					</span>{" "}
					<time datetime={photo.takenAt}>{formatDate(photo.takenAt)}</time>
					{photo.credit && (
						<>
							{" "}
							<span class="line">Photo by {photo.credit}</span>
						</>
					)}{" "}
					<span class="line">
						<Anchor href={getPhotoUrl(photo)} rel="noopener" target="_blank">
							Open original
							<span class="hint">(opens in a new tab)</span>
						</Anchor>
					</span>
				</Text>
			</details>
		</li>
	))}
</ul>

<style>
	.gallery {
		gap: 1rem;
		list-style: none;
		margin: 0 auto;
		padding: 0;
		width: var(--widthFull);
		max-width: 100%;
	}

	/* Masonry, where it's supported, which fills whichever lane is shortest */
	@supports (display: grid-lanes) {
		.gallery {
			display: grid-lanes;
			grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
		}
	}

	/* Elsewhere, columns look the same, but fill one column before the next */
	@supports not (display: grid-lanes) {
		.gallery {
			columns: 3 15rem;
		}

		.item {
			break-inside: avoid;
			margin-bottom: 1rem;
		}
	}

	.summary {
		border-radius: 0.5rem;
		cursor: pointer;
		display: block;
		list-style: none;
		overflow: hidden;
	}

	.summary::-webkit-details-marker {
		display: none;
	}

	.image {
		display: block;
		height: auto;
		transition: var(--transitionMedium) scale;
		width: 100%;
	}

	.summary:hover .image,
	.summary:focus-visible .image {
		scale: 1.02;
	}

	:global(html[data-motion="paused"]) .image {
		transition: none;
	}

	.details {
		position: relative;
	}

	/* Over the photo, so that opening one never moves any others */
	.caption {
		/* Light text, as on the dark theme, over a scrim that's dark in either theme */
		--colorForeground: #f4f9fd;
		--colorMuted: #d3deea;
		--squiggleStart: hsl(230 44% 74% / 64%);
		--squiggleMiddle: hsl(170 44% 74% / 64%);
		--squiggleEnd: hsl(266 44% 74% / 64%);
		--squiggleGray: hsl(0 0% 74% / 64%);
		--squiggleHighlight: rgb(198 222 255 / 95%);

		background: linear-gradient(
			to top,
			rgb(8 14 28 / 88%),
			rgb(8 14 28 / 72%) 70%,
			transparent
		);
		border-radius: 0 0 0.5rem 0.5rem;
		bottom: 0;
		left: 0;
		letter-spacing: 0.04em;
		line-height: 1.6;
		margin: 0;
		padding: 2.5rem 0.85rem 0.7rem;
		position: absolute;
		right: 0;
	}

	.event {
		color: var(--colorForeground);
	}

	.dot {
		padding: 0 0.15em;
	}

	.line {
		display: block;
	}

	.hint {
		clip-path: inset(50%);
		height: 1px;
		overflow: hidden;
		position: absolute;
		white-space: nowrap;
		width: 1px;
	}
</style>
