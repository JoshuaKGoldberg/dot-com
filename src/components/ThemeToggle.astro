---
import Moon from "astro-heroicons/outline/Moon.astro";
import Sun from "astro-heroicons/outline/Sun.astro";

import HeaderToggle from "./HeaderToggle.astro";
---

<HeaderToggle
	clearLabel="Clear theme preference"
	label="Dark theme"
	setting="theme"
>
	<Moon class="moon" />
	<Sun class="sun" />
</HeaderToggle>

<script>
	import { fadeTheme } from "~/theme/fadeTheme";

	document.addEventListener("theme:before-change", fadeTheme);
</script>

<style>
	/* The old icon orbits out one side, then the new one orbits in from the other */
	.moon,
	.sun {
		transform-origin: 50% 1.75rem;
	}

	:global(html[data-motion="playing"]) :is(.moon, .sun) {
		transition:
			var(--transitionSlow) calc(var(--transitionSlow) / 2) opacity,
			var(--transitionSlow) calc(var(--transitionSlow) / 2) transform;
	}

	:global(html.dark) .sun,
	:global(html:not(.dark)) .moon {
		opacity: 0;
		transition-delay: 0s;
	}

	:global(html.dark) .sun {
		transform: rotate(-90deg);
	}

	:global(html:not(.dark)) .moon {
		transform: rotate(90deg);
	}
</style>
