---
import XMark from "astro-heroicons/micro/XMark.astro";
import Moon from "astro-heroicons/outline/Moon.astro";
import Sun from "astro-heroicons/outline/Sun.astro";

import HeaderToggle from "./HeaderToggle.astro";
---

<div class="theme-buttons">
	<HeaderToggle
		id="themeToggle"
		label="Theme toggle (enable JavaScript to use)"
	>
		<Moon data-state="dark" />
		<Sun data-out data-state="light" />
	</HeaderToggle>
	<button
		aria-label="Clear theme preference (enable JavaScript to use)"
		id="themeClear"
		type="button"
	>
		<XMark height={16} width={16} />
	</button>
</div>

<script is:inline>
	{
		const clear = document.getElementById("themeClear");
		const toggle = document.getElementById("themeToggle");

		// Storage throws when the browser is set to block site data
		const readStoredTheme = () => {
			try {
				return localStorage.getItem("theme");
			} catch {
				return null;
			}
		};

		/**
		 * @param {string | null} theme
		 */
		const storeTheme = (theme) => {
			try {
				if (theme) {
					localStorage.setItem("theme", theme);
				} else {
					localStorage.removeItem("theme");
				}
			} catch {
				// The choice still applies until the next page load
			}
		};

		const getPreferredTheme = () =>
			matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

		const update = (storedTheme = readStoredTheme()) => {
			const theme = storedTheme ?? getPreferredTheme();

			document.documentElement.classList.toggle("dark", theme === "dark");
			clear.classList.toggle("clear-active", !!storedTheme);
			toggle.setAttribute("aria-label", `Theme toggle (current: ${theme})`);

			for (const icon of toggle.children) {
				icon.toggleAttribute("data-out", icon.dataset.state !== theme);
			}
		};

		clear.addEventListener("click", () => {
			storeTheme(null);
			toggle.dataset.used = "";
			update(null);
		});

		toggle.addEventListener("click", () => {
			const theme = document.documentElement.classList.contains("dark")
				? "light"
				: "dark";

			storeTheme(theme);
			toggle.dataset.used = "";
			update(theme);
		});

		update();

		// The header is kept between pages, but the root's attributes aren't
		document.addEventListener("astro:after-swap", () => {
			update();
		});
	}
</script>

<style>
	.theme-buttons {
		display: flex;
		justify-content: center;
		padding: 0 1rem;
		position: relative;
		width: 4.25rem;
	}

	#themeClear {
		background: none;
		border: 0;
		color: var(--colorForeground);
		cursor: pointer;
		display: flex;
		opacity: 1;
		padding: 0.5rem;
		position: absolute;
		right: -1rem;
		top: 0;
		transition:
			var(--transitionMedium) color,
			var(--transitionFast) opacity,
			var(--transitionFast) translate,
			var(--transitionFast) visibility;
	}

	#themeClear:not(.clear-active) {
		opacity: 0;
		translate: 0 0.5rem;
		visibility: hidden;
	}
</style>
