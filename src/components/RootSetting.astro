<script is:inline>
	/**
	 * Keeps a root attribute and its toggle's icons in sync with a setting that's
	 * whatever was last chosen, or if nothing was, the system's preference.
	 *
	 * Inline so that it runs before first paint. The header it's in is kept between
	 * pages, but the root's attributes aren't, so they're reapplied after each swap.
	 */
	function createRootSetting({ apply, beforeChange, id, options, query }) {
		const host = document.getElementById(id);
		const clear = host.querySelector("[data-clear]");
		const toggle = host.querySelector("[data-toggle]");
		const icons = toggle.querySelectorAll("[data-state]");
		const [off, on] = options;
		const preference = matchMedia(query);
		let chosen = read();

		// Storage throws when the browser is set to block site data
		function read() {
			try {
				const stored = localStorage.getItem(id);

				return options.includes(stored) ? stored : undefined;
			} catch {
				return undefined;
			}
		}

		function write() {
			try {
				if (chosen) {
					localStorage.setItem(id, chosen);
				} else {
					localStorage.removeItem(id);
				}
			} catch {
				// The choice still applies until the next full page load
			}
		}

		function getCurrent() {
			return chosen ?? (preference.matches ? on : off);
		}

		function update() {
			const current = getCurrent();

			apply(current, toggle);
			clear.toggleAttribute("data-active", !!chosen);

			for (const icon of icons) {
				icon.toggleAttribute("data-out", icon.dataset.state !== current);
			}
		}

		function choose(choice) {
			beforeChange?.();
			chosen = choice;
			write();
			update();

			// Only lasts for this change's animation, so that nothing else can replay it
			if (
				icons.length &&
				document.documentElement.dataset.motion === "playing"
			) {
				host.dataset.used = "";
			}
		}

		toggle.addEventListener("click", () => {
			choose(getCurrent() === on ? off : on);
		});

		clear.addEventListener("click", () => {
			// It's about to be hidden, which would otherwise lose the focus it has
			toggle.focus({ focusVisible: clear.matches(":focus-visible") });
			choose(undefined);
		});

		host.addEventListener("animationend", ({ target }) => {
			if (!target.hasAttribute("data-out")) {
				delete host.dataset.used;
			}
		});

		preference.addEventListener("change", () => {
			beforeChange?.();
			update();
		});

		document.addEventListener("astro:after-swap", () => {
			// Moving the toggle into the new page would otherwise replay its animation
			delete host.dataset.used;
			update();
		});

		update();
	}
</script>
