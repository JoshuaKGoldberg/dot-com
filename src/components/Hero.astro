---
import HeroPortrait, {
	type HeroPortraitImages,
} from "./hero/HeroPortrait.astro";
import HeroTitle from "./HeroTitle.astro";

interface Props {
	alt: string;
	class?: string | undefined;
	portrait: HeroPortraitImages;
	primary: string;
}
---

<div class:list={["hero", Astro.props.class]}>
	<div class="half first">
		<HeroPortrait alt={Astro.props.alt} {...Astro.props.portrait}>
			<slot name="portrait" />
		</HeroPortrait>
	</div>
	<div class="half second">
		<HeroTitle>{Astro.props.primary}</HeroTitle>
		<slot />
	</div>
</div>

<style>
	.hero {
		margin: clamp(2rem, 8vmin, 8rem) auto;
		overflow-x: clip;
		padding: 0 var(--widthPagePadding) 1rem;
		position: relative;
		width: var(--widthFull);
		max-width: 100%;
	}

	:global([data-fits-screen]) .hero {
		grid-row: 2;
		margin-block: 0;
		padding-bottom: 0.5rem;
	}

	.first {
		float: right;
	}

	@media (min-width: 700px) {
		.hero {
			align-items: center;
			display: flex;
			gap: 2.5rem;
			height: 35vh;
			flex-direction: row;
			margin: clamp(8.5rem, 10vh, 10rem) 0 clamp(5rem, 10vh, 14rem);
			padding: 0;
		}

		/* Starts beneath the header, which is fixed */
		:global([data-fits-screen]) .hero {
			--heroSizeLarge: clamp(10rem, 36dvh, 16rem);

			height: auto;
			padding: 6rem 0 1.5rem;
		}

		.half {
			position: relative;
		}

		.half.first {
			display: flex;
			justify-content: flex-end;
			max-height: initial;
			width: 45%;
		}

		.half.second {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			justify-content: center;
			width: 55%;
		}
	}
</style>
