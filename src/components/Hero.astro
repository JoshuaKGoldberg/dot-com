---
import HeroPortrait, {
	type HeroPortraitImages,
} from "./hero/HeroPortrait.astro";
import HeroTitle from "./HeroTitle.astro";

interface Props {
	alt: string;
	class?: string | undefined;
	portrait: HeroPortraitImages;
	primary: string;
}
---

<div class:list={["hero", Astro.props.class]}>
	<div class="half first">
		<HeroPortrait alt={Astro.props.alt} {...Astro.props.portrait} />
	</div>
	<div class="half second">
		<HeroTitle>{Astro.props.primary}</HeroTitle>
		<slot />
	</div>
</div>

<style>
	.hero {
		--heroScale: 0.75;
		--heroSecondarySize: var(--fontSizeMedium);
		--heroTertiarySize: var(--fontSizeSmaller);

		margin: clamp(1.15rem, 4.5vmin, 2rem) auto clamp(1.3rem, 5.35vmin, 2.4rem);
		overflow-x: clip;
		padding: 0 var(--widthPagePadding) 0.67rem;
		position: relative;
		width: var(--widthFull);
		max-width: 100%;
	}

	:global([data-fits-screen]) .hero {
		--heroScale: 1;
		--heroSecondarySize: var(--fontSizeSubtitle);
		--heroTertiarySize: var(--fontSizeMedium);

		grid-row: 2;
		margin-block: clamp(0rem, 16dvh - 6.4rem, 2rem) 0;
		padding-bottom: 0;
	}

	.first {
		float: right;
		margin-left: 1rem;
	}

	/* Stays beside the portrait, rather than having some lines wrap around it */
	.second {
		display: flow-root;
	}

	@media (width >= 43.75em) {
		.hero {
			align-items: center;
			display: flex;
			gap: 2.5rem;
			flex-direction: row;
			margin: max(7.4rem, 4rem + 10vh) 0 max(3.7rem, 18.25vh - 4rem);
			padding: 0;
		}

		:global([data-fits-screen]) .hero {
			--heroSizeLarge: clamp(10rem, 36dvh, 16rem);

			margin-block: 0;
			padding: 4.5rem 0 1.5rem;
		}

		.half {
			position: relative;
		}

		.half.first {
			display: flex;
			justify-content: flex-end;
			margin: 0;
			max-height: initial;
			width: 45%;
		}

		.half.second {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			justify-content: center;
			width: 55%;
		}
	}
</style>
