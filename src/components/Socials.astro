---
import bluesky from "~/assets/icons/bluesky.svg";
import github from "~/assets/icons/github.svg";
import mastodon from "~/assets/icons/mastodon.svg";
import { socialUrls } from "~/constants";

import SocialImage from "./SocialImage.astro";

const socials = [
	["Bluesky", socialUrls.bluesky, bluesky],
	// GitHub's heaviest contribution squares: #216E39 in light themes, #39D353 in dark
	[
		"GitHub",
		socialUrls.github,
		github,
		{ brightness: 1.88, hueRotate: -7, saturate: 1.14 },
	],
	["Mastodon", socialUrls.mastodon, mastodon],
] as const;
---

<p class="socials">
	{socials.map(([alt, href, image, dark]) => (
		<a class="social" href={href} target="_blank">
			<SocialImage alt={alt} dark={dark} image={image} />
		</a>
	))}
</p>

<style>
	.socials {
		display: flex;
		gap: 1.25rem;
		margin: clamp(0.75rem, 3vh, 1.5rem) 0 0;
	}

	.social {
		--socialSize: 1.5rem;

		display: flex;
	}
</style>
