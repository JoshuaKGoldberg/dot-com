---
import bluesky from "~/assets/icons/bluesky.svg";
import github from "~/assets/icons/github.svg";
import mastodon from "~/assets/icons/mastodon.svg";
import { brandColors, socialUrls } from "~/constants";

import SocialImage from "./SocialImage.astro";

const socials = [
	["Bluesky", socialUrls.bluesky, bluesky, brandColors.bluesky],
	["GitHub", socialUrls.github, github, brandColors.github],
	["Mastodon", socialUrls.mastodon, mastodon, brandColors.mastodon],
] as const;
---

<p class="socials">
	{socials.map(([alt, href, image, litColor]) => (
		<a class="social" href={href} target="_blank">
			<SocialImage alt={alt} image={image} litColor={litColor} />
		</a>
	))}
</p>

<style>
	.socials {
		display: flex;
		gap: 1.25rem;
		margin: clamp(0.75rem, 3vh, 1.5rem) 0 0;
	}

	.social {
		--socialSize: 1.5rem;

		display: flex;
	}
</style>
