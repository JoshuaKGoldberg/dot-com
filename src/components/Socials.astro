---
import bluesky from "~/assets/icons/bluesky.svg";
import github from "~/assets/icons/github.svg";
import mastodon from "~/assets/icons/mastodon.svg";
import { Squiggly } from "~/components/Squiggly";

import SocialImage from "./SocialImage.astro";

const socials = [
	["Bluesky", "https://bsky.app/profile/joshuakgoldberg.com", bluesky],
	["GitHub", "https://github.com/JoshuaKGoldberg", github],
	["Mastodon", "https://fosstodon.org/@JoshuaKGoldberg", mastodon],
] as const;
---

<p class="socials">
	{socials.map(([alt, href, image]) => (
		<Squiggly
			as="a"
			class="social"
			href={href}
			target="_blank"
			variant="onHover"
		>
			<SocialImage alt={alt} image={image} />
		</Squiggly>
	))}
</p>

<style>
	.socials {
		display: flex;
		gap: 1.25rem;
		margin: clamp(0.75rem, 3vh, 1.5rem) 0 0;
	}

	.social {
		--squiggleOffset: 0.2rem;
	}

	.social :global(img) {
		display: block;
		height: 1.5rem;
		width: 1.5rem;
	}
</style>
