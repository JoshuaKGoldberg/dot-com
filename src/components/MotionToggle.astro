---
import Pause from "astro-heroicons/outline/Pause.astro";
import Play from "astro-heroicons/outline/Play.astro";

import HeaderToggle from "./HeaderToggle.astro";
---

<HeaderToggle
	clear="Clear motion preference"
	id="motion"
	label="Pause animations"
>
	<Pause data-state="playing" />
	<Play data-state="paused" />
</HeaderToggle>

<script is:inline>
	createRootSetting({
		apply(motion, toggle) {
			document.documentElement.dataset.motion = motion;
			toggle.setAttribute("aria-pressed", String(motion === "paused"));
		},
		id: "motion",
		options: ["playing", "paused"],
		query: "(prefers-reduced-motion: reduce)",
	});
</script>
