---
import BlogShare from "./BlogShare.astro";

interface Props {
	description: string;
	title: string;
	url: URL;
}
---

<hr />
<BlogShare {...Astro.props}>
	Liked this post? Thanks! Let the world know:
</BlogShare>
<!-- prettier-ignore -->
<p class="feed">
	Want to see new posts? They're shared to an RSS feed at <a href="/rss.xml" target="_blank">/rss.xml</a>.
</p>

<style>
	.feed {
		margin: 0;
	}
</style>
