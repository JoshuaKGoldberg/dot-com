---
import type { CollectionEntry } from "astro:content";

import { InlineMarkdown } from "../InlineMarkdown";

interface Props {
	entry: CollectionEntry<"blog">;
	label: string;
}
---

<div>
	{Astro.props.label} post:{" "}
	<a href={`/blog/${Astro.props.entry.id}`}>
		<InlineMarkdown insideLink text={Astro.props.entry.data.title} />
	</a>
</div>
