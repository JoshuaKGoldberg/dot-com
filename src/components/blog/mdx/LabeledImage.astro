---
import type { ImageMetadata } from "astro";

import { Image } from "astro:assets";

import type { MediaOriginal } from "./MediaOriginalNote.astro";

import LabeledMedia from "./LabeledMedia.astro";

interface Props {
	alt: string;
	description: string | string[];
	note?: string;
	original?: MediaOriginal | string;
	src: ImageMetadata;
	wide?: boolean;
}

const alt =
	Astro.props.alt ??
	(Array.isArray(Astro.props.description)
		? Astro.props.description.join(" ")
		: Astro.props.description);

const { height, width } = Astro.props.src;

const articleWidth = 752;
const maximumHeight = 400;
const maximumWidth = Astro.props.wide ? articleWidth : 600;

const displayWidth = Math.round(
	Math.min(width, maximumWidth, (maximumHeight * width) / height),
);

const phoneAndTabletWidths = [480, 640, 720, 960];

const widths = [
	...new Set([...phoneAndTabletWidths, displayWidth, displayWidth * 2]),
].filter((candidate) => candidate <= Math.min(width, displayWidth * 2));
---

<LabeledMedia
	class="labeled-image-media"
	description={Astro.props.description}
	note={Astro.props.note}
	original={Astro.props.original}
>
	<Image
		alt={alt}
		class="labeled-image"
		format="avif"
		height={Math.round((displayWidth * height) / width)}
		quality={55}
		sizes={`min(100vw, ${displayWidth}px)`}
		src={Astro.props.src}
		width={displayWidth}
		widths={widths}
	/>
</LabeledMedia>

<style is:inline>
	.labeled-image {
		height: auto;
		max-width: 100%;
	}
</style>
