---
import type { ImageMetadata } from "astro";

import { Image } from "astro:assets";

import type { MediaOriginal } from "./MediaOriginalNote.astro";

import LabeledMedia from "./LabeledMedia.astro";

interface Props {
	alt: string;
	description: string | string[];
	note?: string;
	original?: MediaOriginal | string;
	src: ImageMetadata;
	wide?: boolean;
}

const alt =
	Astro.props.alt ??
	(Array.isArray(Astro.props.description)
		? Astro.props.description.join(" ")
		: Astro.props.description);

const { height, width } = Astro.props.src;

/** Tallest and, unless they're wide, widest that images are displayed. */
const maximumHeight = 400;
const maximumWidth = Astro.props.wide ? Infinity : 600;

// Knowing exactly how wide the image will be displayed reserves the right space for it
const displayWidth = Math.round(
	Math.min(width, maximumWidth, (maximumHeight * width) / height),
);

// Enough for phones, for smaller screens, and for high-density screens
const widths = [480, 640, 720, 960, displayWidth, displayWidth * 2].filter(
	(candidate) => candidate <= Math.min(width, displayWidth * 2),
);

// A post's first image is often visible right away, so it shouldn't wait to be loaded
const isFirst = !Astro.locals.hasLabeledImage;

Astro.locals.hasLabeledImage = true;
---

<LabeledMedia
	class="labeled-image-media"
	description={Astro.props.description}
	note={Astro.props.note}
	original={Astro.props.original}
>
	<Image
		alt={alt}
		class="labeled-image"
		{...(isFirst && { fetchpriority: "high", loading: "eager" })}
		height={Math.round((displayWidth * height) / width)}
		format="avif"
		quality={55}
		sizes={`min(100vw, ${displayWidth}px)`}
		src={Astro.props.src}
		width={displayWidth}
		widths={widths}
	/>
</LabeledMedia>

<style is:inline>
	.labeled-image {
		height: auto;
		max-width: 100%;
	}
</style>
