---
import type { ImageMetadata } from "astro";

import { Image } from "astro:assets";

import LabeledMedia from "./LabeledMedia.astro";

export interface LabeledImage {
	alt: string;
	description?: string;
	original?: string;
	src: ImageMetadata;
}

interface Props {
	description?: string;
	images: [LabeledImage, LabeledImage];
}

const displayWidth = 372;
---

<LabeledMedia description={Astro.props.description}>
	<div class="labeled-images">
		{Astro.props.images.map((image) => (
			<div class="labeled-image-container">
				<Image
					alt={image.alt}
					class="labeled-images-image"
					format="avif"
					quality={55}
					sizes={`min(50vw, ${displayWidth}px)`}
					src={image.src}
					width={Math.min(displayWidth, image.src.width)}
					widths={[240, displayWidth, displayWidth * 2].filter(
						(width) => width <= image.src.width,
					)}
				/>
				{image.description && (
					<div class="labeled-image-description">{image.description}</div>
				)}
				{image.original && (
					<span class="labeled-image-original">
						[<a href={image.original}>original</a>]
					</span>
				)}
			</div>
		))}
	</div>
</LabeledMedia>

<style is:inline>
	.labeled-images {
		display: flex;
		gap: 0.5rem;
	}

	.labeled-image-container {
		max-width: calc(50% - 0.25rem);
	}

	.labeled-images-image {
		display: block;
		height: auto;
		margin: auto;
		width: 100%;
	}

	.labeled-image-description {
		margin-top: 0.5rem;
	}

	.labeled-image-original {
		font-size: 1rem;
	}
</style>
