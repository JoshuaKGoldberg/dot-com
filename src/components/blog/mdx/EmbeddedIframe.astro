---
interface Props {
	src: string;
	title: string;
}
---

<iframe
	allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
	allowfullscreen
	class="embedded-iframe"
	height="315"
	loading="lazy"
	src={Astro.props.src}
	title={Astro.props.title}
	width="560"
></iframe>
<em class="embedded-iframe-em">
	<slot name="primary" />
	<small>
		<slot name="secondary" />
	</small>
</em>

<style is:inline>
	.embedded-iframe {
		aspect-ratio: 16 / 9;
		border: 0;
		height: auto;
		margin: auto;
		max-width: 100%;
	}

	.embedded-iframe-em {
		display: block;
		margin-bottom: 2rem;
		text-align: center;
	}
</style>
