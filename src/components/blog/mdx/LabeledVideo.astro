---
import LabeledMedia from "./LabeledMedia.astro";
import { LoopedVideo } from "./LoopedVideo";
import { readVideoSize } from "./readVideoSize";

interface Props {
	description?: string;
	original?: string;
	src: string;
	title: string;
}
---

<LabeledMedia
	description={Astro.props.description}
	original={Astro.props.original}
>
	<LoopedVideo
		client:visible
		size={await readVideoSize(Astro.props.src)}
		src={Astro.props.src}
		title={Astro.props.title}
	/>
</LabeledMedia>
