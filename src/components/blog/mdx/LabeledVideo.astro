---
import LabeledMedia from "./LabeledMedia.astro";
import Video from "./Video.astro";

interface Props {
	alt: string;
	description?: string;
	original?: string;
	src: string;
}

const { alt, description, original, src } = Astro.props;
---

<LabeledMedia description={description} original={original}>
	<Video alt={alt} src={src} />
</LabeledMedia>
