---
import bluesky from "~/assets/icons/bluesky.svg";
import email from "~/assets/icons/email.svg";
import linkedin from "~/assets/icons/linkedin.svg";
import mastodon from "~/assets/icons/mastodon.svg";
import { siteName } from "~/constants";

import SocialImage from "../SocialImage.astro";

interface Props {
	description: string;
	title: string;
	url: URL;
}

const { description, title } = Astro.props;
const url = Astro.props.url.toString();

function createLink(base: string, parameters: Record<string, string>) {
	// Not URLSearchParams, as not every network reads its + signs as spaces
	const query = Object.entries(parameters)
		.map(([key, value]) => `${key}=${encodeURIComponent(value)}`)
		.join("&");

	return `${base}?${query}`;
}

function createText(author: string) {
	return [`📝 ${title}`, `"${description}"`, `- by ${author}`, url].join(
		"\n\n",
	);
}

const channels = [
	[
		"Share on Bluesky",
		createLink("https://bsky.app/intent/compose", {
			text: createText("@joshuakgoldberg.com"),
		}),
		bluesky,
	],
	[
		"Share on LinkedIn",
		createLink("https://linkedin.com/sharing/share-offsite/", { url }),
		linkedin,
	],
	[
		"Share on Mastodon",
		createLink("https://fosstodon.org/share", {
			text: createText("@JoshuaKGoldberg@fosstodon.org"),
		}),
		mastodon,
	],
	[
		"Share by email",
		createLink("mailto:", {
			// Line breaks in email bodies are specified to be CRLF
			body: createText(siteName).replaceAll("\n", "\r\n"),
			subject: title,
		}),
		email,
	],
] as const;
---

<span class="shares">
	<slot />
	{channels.map(([label, href, image]) => (
		<a class="share" href={href} target="_blank" title={label}>
			<SocialImage alt={label} image={image} />
		</a>
	))}
</span>

<style>
	.shares {
		align-items: baseline;
		display: inline-flex;
		gap: 1rem;
		margin: 0.5em 0 0;
	}

	@media (width >= 43.75em) {
		.shares {
			margin: 0 0 -0.25em;
		}
	}
</style>
