---
import type { ImageMetadata } from "astro";

import HeroImage from "../HeroImage.astro";
import HeroSecondary from "../HeroSecondary.astro";
import HeroTertiary from "../HeroTertiary.astro";
import HeroTitle from "../HeroTitle.astro";
import { InlineMarkdown, inlineMarkdownToText } from "../InlineMarkdown";
import BlogShare from "./BlogShare.astro";
import { DateAndMinutes } from "./DateAndMinutes";

export interface BlogImage {
	alt: string;
	src: ImageMetadata;
}

interface Props {
	date: Date;
	/** Markdown, as only inline syntax such as `code` */
	description: string;
	download?: string | undefined;
	image: BlogImage;
	minutes: number;
	/** Markdown, as only inline syntax such as `code` */
	title: string;
}
---

<div class="blogHero">
	<div class="left">
		<div class="primary">
			<div class="image">
				<HeroImage {...Astro.props.image} />
			</div>
			<div class="hero-title">
				<HeroTitle>
					<InlineMarkdown text={Astro.props.title} />
				</HeroTitle>
			</div>
			<div class="hero-tertiary">
				<HeroTertiary size="unlimited">
					<DateAndMinutes
						date={Astro.props.date}
						minutes={Astro.props.minutes}
						year="numeric"
					>
						<BlogShare
							description={inlineMarkdownToText(Astro.props.description)}
							title={inlineMarkdownToText(Astro.props.title)}
							url={Astro.url}
						/>
					</DateAndMinutes>
				</HeroTertiary>
			</div>
		</div>
		<HeroSecondary size="wide">
			<InlineMarkdown text={Astro.props.description} />
		</HeroSecondary>
	</div>
	{Astro.props.download && (
		<div class="download">
			💾
			<a href={Astro.props.download} rel="noopener noreferrer" target="_blank">
				Download the slides here!
			</a>
		</div>
	)}
</div>

<style>
	.primary {
		width: 100%;
	}

	.image {
		float: right;
		/* Otherwise sticks out just far enough to make the date's line narrower too */
		margin: 0 0 -2px 0.1rem;
	}

	.download {
		margin-top: 1.5rem;
	}

	@media (width >= 30.625em) {
		.primary {
			display: grid;
			column-gap: 0.5rem;
			grid-template-columns: auto var(--heroSizeSmall);
			grid-template-rows: max-content max-content auto;
		}

		.image {
			grid-column: 2;
			grid-row: 1 / 3;
			display: flex;
			justify-content: flex-end;
			margin: 0;
		}

		.hero-title {
			display: flex;
			flex-direction: column;
			justify-content: center;
		}

		.hero-tertiary {
			grid-column: 1 / 3;
			grid-row: 2;
		}
	}

	@media (width >= 43.75em) {
		.primary {
			grid-template-columns: var(--heroSizeSmall) auto;
			grid-template-rows: auto;
			margin-bottom: 1.5rem;
			column-gap: 1.5rem;
			grid-column: 2;
		}

		.image {
			grid-column: 1;
		}

		.hero-tertiary {
			grid-column: 2;
		}
	}

	@media (width >= 63.5625em) {
		.blogHero {
			margin-right: var(--widthTableOfContents);
		}
	}
</style>
