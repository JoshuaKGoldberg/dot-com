---
import { Text } from "~/components/Text";

interface Props {
	size?: "normal" | "wide" | undefined;
}
---

<Text as="p" class:list={["tertiary", Astro.props.size ?? "normal"]}>
	<slot />
</Text>

<style>
	.tertiary {
		--squiggleOffset: -0.49em;

		font-size: var(--heroTertiarySize, var(--fontSizeMedium));
		line-height: 1.35;
		margin-top: 1rem;
		text-wrap: balance;
	}

	.tertiary.normal {
		max-width: calc(25rem * var(--heroScale, 1));
	}
</style>
