---
import { Text } from "~/components/Text";
---

<Text as="p" class="tertiary" fontSize="medium" fontWeight="light">
	<slot />
</Text>

<style>
	.tertiary {
		font-size: var(--heroTertiarySize, var(--fontSizeMedium));
		line-height: 1.35;
		margin-top: 1rem;
		max-width: calc(25rem * var(--heroScale, 1));
	}

	@media (min-width: 700px) {
		.tertiary {
			margin-left: 0;
		}
	}
</style>
