---
import type { ImageMetadata } from "astro";

import { Image } from "astro:assets";

import { getTone } from "./hero/getTone";
import GlassRing from "./hero/GlassRing.astro";

interface Props {
	alt: string;
	src: ImageMetadata;
}

// The image's displayed size at most, per --heroSizeSmall
const size = 144;
---

<div class="hero-image">
	<div
		class="figure"
		data-layer="figure"
		data-tone={await getTone(Astro.props.src)}
	>
		<Image
			alt={Astro.props.alt}
			densities={[1, 2]}
			fetchpriority="high"
			fit="cover"
			height={size}
			loading="eager"
			src={Astro.props.src}
			width={size}
		/>
	</div>
	<GlassRing />
</div>

<style>
	.hero-image {
		--imageSize: var(--heroSizeSmall);

		view-transition-name: portrait;
		height: var(--imageSize);
		position: relative;
		width: var(--imageSize);
	}

	.figure {
		view-transition-name: portrait-figure;
		height: 100%;
	}

	.hero-image img {
		border-radius: 100%;
		display: block;
		height: 100%;
		object-fit: cover;
		user-select: none;
		width: 100%;
	}
</style>
