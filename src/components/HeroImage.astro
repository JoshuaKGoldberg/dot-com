---
import type { ImageMetadata } from "astro";

import { Image } from "astro:assets";

interface Props {
	alt: string;
	class?: string | undefined;
	src: ImageMetadata;
}

// The image's displayed size at most, per --heroSizeSmall
const size = 144;
---

<div class:list={["hero-image", Astro.props.class]}>
	<Image
		alt={Astro.props.alt}
		densities={[1, 2]}
		fetchpriority="high"
		fit="cover"
		height={size}
		loading="eager"
		src={Astro.props.src}
		width={size}
	/>
</div>

<style>
	.hero-image {
		--imageSize: var(--heroSizeSmall);

		height: var(--imageSize);
		width: var(--imageSize);
	}

	.hero-image img {
		border-radius: 100%;
		box-shadow: 0 0 0 1px
			color-mix(in srgb, var(--auroraWisteria) 30%, transparent);
		display: block;
		height: 100%;
		max-height: 100%;
		max-width: 100%;
		object-fit: cover;
		user-select: none;
		width: 100%;
	}
</style>
