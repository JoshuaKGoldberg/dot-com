---
import type { ImageMetadata } from "astro";

import { Image } from "astro:assets";

import FadeImagesIn from "./hero/FadeImagesIn.astro";
import { getTone } from "./hero/getTone";
import GlassRing from "./hero/GlassRing.astro";

interface Props {
	alt: string;
	src: ImageMetadata;
}

const largestDisplayedSize = 128;
---

<div class="hero-image">
	<div
		class="figure"
		data-layer="figure"
		data-tone={await getTone(Astro.props.src)}
	>
		<Image
			alt={Astro.props.alt}
			data-fades-in
			densities={[1, 2]}
			fetchpriority="high"
			fit="cover"
			height={largestDisplayedSize}
			loading="eager"
			src={Astro.props.src}
			width={largestDisplayedSize}
		/>
	</div>
	<GlassRing />
</div>

<FadeImagesIn />

<style>
	.hero-image {
		view-transition-name: portrait;
		height: var(--heroSizeSmall);
		position: relative;
		width: var(--heroSizeSmall);
	}

	.figure {
		view-transition-name: portrait-figure;
		height: 100%;
	}

	.hero-image img {
		border-radius: 100%;
		display: block;
		height: 100%;
		object-fit: cover;
		user-select: none;
		width: 100%;
	}
</style>
