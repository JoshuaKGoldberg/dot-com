---
import HeaderLink from "./HeaderLink.astro";
import MotionToggle from "./MotionToggle.astro";
import { Text } from "./Text";
import ThemeToggle from "./ThemeToggle.astro";

const links = [
	["Book", "https://learningtypescript.com"],
	["Blog", "/blog"],
	["Projects", "/projects"],
	["Speaking", "/speaking"],
] as const;
---

<div class="persisted" transition:persist="header">
	<div class="fader"></div>
	<Text as="header">
		<div class="first">
			<HeaderLink href="/">Josh Goldberg</HeaderLink>
			<div class="toggles">
				<MotionToggle />
				<ThemeToggle />
			</div>
		</div>
		<nav aria-label="Main" class="links">
			{links.map(([text, href]) => {
				return <HeaderLink href={href}>{text}</HeaderLink>;
			})}
		</nav>
	</Text>
</div>

<script>
	import { keepLinkStyles } from "~/transitions/keepLinkStyles";

	// The header is kept between pages, so that changes to its links are animated
	document.addEventListener("astro:before-swap", ({ to }) => {
		document.addEventListener("astro:after-swap", keepLinkStyles(to), {
			once: true,
		});
	});
</script>

<style>
	.persisted {
		display: contents;
	}

	header {
		view-transition-name: header;
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 3.5rem;
		justify-content: space-between;
		padding: 2rem var(--widthPagePadding);
		position: relative;
		width: 100%;
	}

	.first {
		--linkWeight: 500;

		align-items: center;
		display: flex;
		justify-content: space-between;
		width: 100%;
	}

	/* Centered with how tall the text looks, rather than how tall it is */
	.toggles {
		display: flex;
		position: relative;
		top: -0.1rem;
	}

	.links {
		align-items: center;
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 0 1rem;
	}

	@media (width < 43.75em) {
		.first {
			--linkSize: var(--fontSizeSubtitle);
		}

		.toggles {
			gap: 0.375rem;
		}
	}

	@keyframes fader-in {
		to {
			opacity: 1;
		}
	}

	@media (width >= 43.75em) {
		header {
			flex-wrap: nowrap;
			gap: 1.5rem;
			max-width: var(--widthFull);
			position: fixed;
			top: 0;
			z-index: 1;
		}

		/* Hides content scrolled beneath the header, without hiding the aurora at rest */
		.fader {
			--column: calc(var(--widthFull) / 2);

			background: linear-gradient(
				to bottom,
				var(--colorBackground) 55%,
				transparent
			);
			height: var(--heightMinimumFromHeader);
			left: 0;
			mask-image: linear-gradient(
				to right,
				transparent calc(50% - var(--column) - 6rem),
				black calc(50% - var(--column)) calc(50% + var(--column)),
				transparent calc(50% + var(--column) + 6rem)
			);
			pointer-events: none;
			position: fixed;
			right: 0;
			top: 0;
			view-transition-name: fader;
			z-index: 1;
		}

		/* Pages too short to scroll have nothing to hide, and no timeline to play */
		@supports (animation-timeline: scroll()) {
			.fader {
				animation-fill-mode: both;
				animation-name: fader-in;
				animation-range: 0 5rem;
				animation-timeline: --page;
				animation-timing-function: linear;
				opacity: 0;
			}
		}

		@media (forced-colors: active) {
			.fader {
				background: Canvas;
				height: 5rem;
			}
		}

		.first {
			flex-grow: 100;
			padding-right: 3rem;
			position: relative;
			width: initial;
		}

		.first::after {
			background: var(--colorForeground);
			content: "";
			display: block;
			height: 0.7rem;
			opacity: 0.5;
			position: absolute;
			right: 1.5rem;
			top: calc(50% - 0.5rem);
			width: 1px;
		}

		.links {
			gap: 0 1.5rem;
			justify-content: end;
			position: relative;
		}
	}

	/* Otherwise printed on top of every page */
	@media print {
		header {
			position: static;
		}

		.fader,
		.toggles {
			display: none;
		}
	}

	@media (width >= 63.5625em) {
		header {
			padding: 2rem 0;
		}
	}
</style>
