---
import HeaderLink from "./HeaderLink.astro";
import MotionToggle from "./MotionToggle.astro";
import RootSetting from "./RootSetting.astro";
import { Text } from "./Text";
import ThemeToggle from "./ThemeToggle.astro";

const links = [
	["Book", "https://learningtypescript.com"],
	["Blog", "/blog"],
	["Projects", "/projects"],
	["Speaking", "/speaking"],
] as const;
---

<div class="persisted" transition:persist="header">
	<div class="fader" role="presentation"></div>
	<Text as="header" fontWeight="bold">
		<div class="first">
			<HeaderLink href="/">Josh Goldberg</HeaderLink>
			<div class="toggles">
				<RootSetting />
				<MotionToggle />
				<ThemeToggle />
			</div>
		</div>
		<div class="links">
			{links.map(([text, href]) => {
				return <HeaderLink href={href}>{text}</HeaderLink>;
			})}
		</div>
	</Text>
</div>

<script>
	import { keepLinkStyles } from "~/transitions/keepLinkStyles";

	// The header is kept between pages, so that changes to its links are animated
	document.addEventListener("astro:before-swap", () => {
		document.addEventListener("astro:after-swap", keepLinkStyles(), {
			once: true,
		});
	});
</script>

<style>
	.persisted {
		display: contents;
	}

	header {
		view-transition-name: header;
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 3.5rem;
		justify-content: space-between;
		padding: 2rem var(--widthPagePadding);
		position: relative;
		width: 100%;
	}

	.first {
		align-items: center;
		display: flex;
		justify-content: space-between;
		width: 100%;
	}

	/* Centered with how tall the text looks, rather than how tall it is */
	.toggles {
		display: flex;
		position: relative;
		top: -0.1rem;
	}

	.links {
		align-items: center;
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 0 1rem;
	}

	@media (max-width: 699px) {
		.first {
			--linkScale: 1.2;
		}

		.toggles {
			gap: 0.375rem;
		}
	}

	@keyframes fader-in {
		to {
			opacity: 1;
		}
	}

	@media (min-width: 700px) {
		header {
			gap: 1.5rem;
			justify-content: space-between;
			max-width: calc(var(--widthFull) - 1rem);
			position: fixed;
			z-index: 1;
		}

		/* Hides content scrolled beneath the header, without hiding the aurora at rest */
		.fader {
			--column: calc(var(--widthFull) / 2);

			background: linear-gradient(
				to bottom,
				var(--colorBackground) 55%,
				transparent
			);
			height: var(--heightMinimumFromHeader);
			left: 0;
			mask-image: linear-gradient(
				to right,
				transparent calc(50% - var(--column) - 6rem),
				black calc(50% - var(--column)) calc(50% + var(--column)),
				transparent calc(50% + var(--column) + 6rem)
			);
			pointer-events: none;
			position: fixed;
			right: 0;
			top: 0;
			view-transition-name: fader;
			z-index: 1;
		}

		/* Pages too short to scroll have nothing to hide, and no timeline to play */
		@supports (animation-timeline: scroll()) {
			.fader {
				--fadeDistance: 5rem;

				animation: fader-in linear both;
				/* Without a var(), minifying merges the timeline into the shorthand */
				animation-range: 0 var(--fadeDistance);
				animation-timeline: --page;
				opacity: 0;
			}
		}

		.first {
			flex-grow: 100;
			padding-right: 3rem;
			position: relative;
			width: initial;
		}

		.first::after {
			background: var(--colorForeground);
			content: "";
			display: block;
			height: 0.7rem;
			position: absolute;
			right: 1.5rem;
			/* Centered with how tall the text and icons look */
			top: calc(50% - 0.5rem);
			width: 1px;
		}

		.links {
			position: relative;
			gap: 1.5rem;
			justify-content: space-between;
		}
	}

	@media (min-width: 1017px) {
		header {
			padding: 2rem 0;
		}
	}
</style>
