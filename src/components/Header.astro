---
import HeaderLink from "./HeaderLink.astro";
import MotionToggle from "./MotionToggle.astro";
import { Text } from "./Text";
import ThemeToggle from "./ThemeToggle.astro";

const links = [
	["Book", "https://learningtypescript.com"],
	["Blog", "/blog"],
	["Projects", "/projects"],
	["Speaking", "/speaking"],
] as const;
---

<div class="fader" role="presentation"></div>
<Text as="header" class="header" fontWeight="bold">
	<div class="first">
		<HeaderLink href="/">Josh Goldberg</HeaderLink>
		<div class="toggles">
			<MotionToggle />
			<ThemeToggle />
		</div>
	</div>
	<div class="links">
		{links.map(([text, href]) => {
			return <HeaderLink href={href}>{text}</HeaderLink>;
		})}
	</div>
</Text>

<style>
	header {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 3.5rem;
		justify-content: space-between;
		padding: 2rem var(--widthPagePadding);
		position: relative;
		width: 100%;
	}

	.first {
		display: flex;
		justify-content: space-between;
		width: 100%;
	}

	.toggles {
		position: relative;
	}

	.links {
		align-items: center;
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 0 1rem;
	}

	@keyframes fader-in {
		from {
			opacity: 0;
		}
	}

	@media (min-width: 700px) {
		header {
			gap: 1.5rem;
			justify-content: space-between;
			max-width: calc(var(--widthFull) - 1rem);
			position: fixed;
			z-index: 1;
		}

		/* Hides content scrolled beneath the header, without hiding the aurora at rest */
		.fader {
			--column: calc(var(--widthFull) / 2);

			background: linear-gradient(
				to bottom,
				var(--colorBackground) 55%,
				transparent
			);
			height: var(--heightMinimumFromHeader);
			left: 0;
			mask-image: linear-gradient(
				to right,
				transparent calc(50% - var(--column) - 6rem),
				black calc(50% - var(--column)) calc(50% + var(--column)),
				transparent calc(50% + var(--column) + 6rem)
			);
			pointer-events: none;
			position: fixed;
			right: 0;
			top: 0;
			z-index: 1;
		}

		@supports (animation-timeline: scroll()) {
			.fader {
				animation: fader-in linear both;
				animation-range: 0 5rem;
				animation-timeline: --page;
			}
		}

		.first {
			flex-grow: 100;
			padding-right: 3rem;
			position: relative;
			width: initial;
		}

		.first::after {
			background: var(--colorForeground);
			content: "";
			display: block;
			height: 0.7rem;
			position: absolute;
			right: 1.5rem;
			top: 0.5rem;
			width: 1px;
		}

		.links {
			position: relative;
			gap: 1.5rem;
			justify-content: space-between;
		}
	}

	@media (min-width: 1017px) {
		header {
			padding: 2rem 0;
		}
	}
</style>
