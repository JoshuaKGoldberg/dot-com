---
import type { ImageMetadata } from "astro";

import { Image } from "astro:assets";

export interface DarkAdjustment {
	brightness: number;
	hueRotate: number;
	saturate: number;
}

interface Props {
	alt: string;
	/** Filters the brand's color in dark themes, for brands that use another one there */
	dark?: DarkAdjustment | undefined;
	image: ImageMetadata;
}
---

<span
	class="social-image"
	data-lit-icon
	style={{ "--icon": `url("${Astro.props.image.src}")` }}
>
	<Image
		alt={Astro.props.alt}
		class="image"
		loading="eager"
		src={Astro.props.image}
		style={
			Astro.props.dark && {
				"--brightness": Astro.props.dark.brightness,
				"--hueRotate": `${Astro.props.dark.hueRotate}deg`,
				"--saturate": Astro.props.dark.saturate,
			}
		}
	/>
</span>

<style>
	.social-image {
		display: inline-block;
		height: var(--socialSize, 1.25rem);
		position: relative;
		transition: var(--transitionMedium) scale;
		width: var(--socialSize, 1.25rem);
		vertical-align: text-bottom;
	}

	.image {
		display: block;
		/* Fades along with the theme, as --iconDarkness does */
		filter: brightness(
				calc(1 + (var(--brightness, 1) - 1) * var(--iconDarkness))
			)
			saturate(calc(1 + (var(--saturate, 1) - 1) * var(--iconDarkness)))
			hue-rotate(calc(var(--hueRotate, 0deg) * var(--iconDarkness)));
		height: 100%;
		width: 100%;
	}

	@media (hover: hover) {
		:global(a:hover) > .social-image {
			scale: 1.15;
		}
	}

	/* Keeps base.css's fade out, which this element's own transition would replace */
	:global([data-motion="paused"]) .social-image[data-lit] {
		transition:
			var(--transitionMedium) scale,
			var(--transitionMedium) --nearness;
	}

	/* Fades in over the icon, like lit links' text fades out over their gradient */
	@media (forced-colors: none) {
		.social-image[data-lit]::after {
			background: var(--litGradient);
			content: "";
			inset: 0;
			mask: var(--icon) center / 100% 100% no-repeat;
			opacity: var(--nearness);
			pointer-events: none;
			position: absolute;
		}
	}

	/* Brands' colors can be too faint on systems' colors, so it's drawn in the system's link color */
	@media (forced-colors: active) {
		.social-image::before {
			background: LinkText;
			content: "";
			forced-color-adjust: none;
			inset: 0;
			mask: var(--icon) center / 100% 100% no-repeat;
			position: absolute;
		}

		.image {
			opacity: 0;
		}
	}
</style>
