---
import type { ImageMetadata } from "astro";

import { Image } from "astro:assets";

interface Props {
	alt: string;
	image: ImageMetadata;
}
---

<Image
	alt={Astro.props.alt}
	class="social-image"
	loading="eager"
	src={Astro.props.image}
/>

<style>
	.social-image {
		filter: invert(var(--iconInversion))
			hue-rotate(calc(var(--iconInversion) * 180deg));
		height: var(--socialSize, 1.25rem);
		width: var(--socialSize, 1.25rem);
		vertical-align: text-bottom;
	}
</style>
