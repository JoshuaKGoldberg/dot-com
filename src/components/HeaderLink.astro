---
import { getCurrent } from "~/utils";

import { Squiggly } from "./Squiggly";

interface Props {
	href: string;
}

const { href } = Astro.props;
---

<Squiggly
	aria-current={getCurrent(href, Astro.url.pathname)}
	as="a"
	class="link"
	data-header-link
	fontWeight="bold"
	href={href}
	{...(href.startsWith("http") && { target: "_blank" })}
	variant="current"
>
	<slot />
</Squiggly>

<style>
	.link {
		display: inline-block;
		font-size: var(--linkSize, var(--fontSizeMedium));
	}

	.link[aria-current] {
		color: var(--colorLit, var(--colorEmphasized));
	}

	/* It's already here. Links for the page's section still go to somewhere else. */
	.link[aria-current="page"] {
		cursor: default;
	}
</style>
