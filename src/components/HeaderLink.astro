---
import { isCurrentPath } from "~/utils";

import { Squiggly } from "./Squiggly";

interface Props {
	href: string;
}

const { href } = Astro.props;
---

<Squiggly
	aria-current={isCurrentPath(href, Astro.url.pathname) ? "true" : undefined}
	as="a"
	class="link"
	fontWeight="bold"
	href={href}
	{...(href.startsWith("http") && { target: "_blank" })}
	variant="nav"
>
	<slot />
</Squiggly>

<style>
	.link {
		display: inline-block;
		/* On the narrowest screens, just small enough for a single row of links */
		font-size: clamp(1.1rem, 0.85rem + 1.4vw, var(--fontSizeMedium));
	}

	.link[aria-current] {
		color: var(--colorEmphasized);
	}
</style>
