---
interface Props {
	id: string;
	label: string;
}

const { id, label } = Astro.props;
---

<button aria-label={label} class="header-toggle" id={id} type="button">
	<span class="icons">
		<slot />
	</span>
</button>

<style>
	/* Needs JavaScript to do anything, which is also what sets data-motion */
	:global(html:not([data-motion])) .header-toggle {
		visibility: hidden;
	}

	.header-toggle {
		background: none;
		border: 0;
		color: var(--colorForeground);
		cursor: pointer;
		display: block;
		padding: 0;
		transition: var(--transitionMedium) color;
	}

	.header-toggle:hover {
		color: var(--colorEmphasized);
	}

	/*
	 * Shows whichever of its two icons its script hasn't marked as being out.
	 * Once it's been used, changing between them has icons orbit in and out.
	 */
	.icons {
		display: block;
		height: 2rem;
		mask-image: linear-gradient(black 70%, transparent 95%);
		position: relative;
		width: 2rem;
	}

	.icons :global(svg) {
		animation-duration: var(--transitionSlow);
		animation-fill-mode: both;
		animation-timing-function: ease;
		height: 1.25rem;
		inset: 0;
		margin: auto;
		position: absolute;
		transform-origin: 50% 1.75rem;
		width: 1.25rem;
	}

	.icons :global([data-out]) {
		opacity: 0;
		transform: rotate(90deg);
	}

	:global(html[data-motion="playing"])
		.header-toggle[data-used]
		:global([data-out]) {
		animation-name: orbit-out;
	}

	:global(html[data-motion="playing"])
		.header-toggle[data-used]
		:global(svg:not([data-out])) {
		animation-delay: calc(var(--transitionSlow) / 2);
		animation-name: orbit-in;
	}

	@keyframes orbit-in {
		from {
			opacity: 0;
			transform: rotate(-90deg);
		}
		to {
			opacity: 1;
			transform: rotate(0deg);
		}
	}

	@keyframes orbit-out {
		from {
			opacity: 1;
			transform: rotate(0deg);
		}
		to {
			opacity: 0;
			transform: rotate(90deg);
		}
	}
</style>
