---
import XMark from "astro-heroicons/micro/XMark.astro";

interface Props {
	/** Label for going back to the system's preference */
	clear: string;

	id: string;
	label: string;
}

const { clear, id, label } = Astro.props;
---

<div class="header-toggle" id={id}>
	<button aria-label={label} class="toggle" data-toggle type="button">
		<span class="icons">
			<slot />
		</span>
	</button>
	<button aria-label={clear} class="clear" data-clear type="button">
		<XMark height={8} width={8} />
	</button>
</div>

<style>
	/* Needs JavaScript to do anything, which is also what sets data-motion */
	:global(html:not([data-motion])) .header-toggle {
		visibility: hidden;
	}

	/* Two targets that don't overlap, as small as accessibility guidelines allow */
	.header-toggle {
		--target: 1.5rem;

		display: flex;
		height: 2rem;
	}

	button {
		background: none;
		border: 0;
		color: var(--colorForeground);
		cursor: pointer;
		display: block;
		padding: 0;
		transition: var(--transitionMedium) color;
		width: var(--target);
	}

	button:hover {
		color: var(--colorEmphasized);
	}

	/* Like a superscript: in the corner of its target that's nearest to the icon */
	.clear {
		align-items: flex-start;
		display: flex;
		height: var(--target);
		padding-top: 0.2rem;
		transition:
			var(--transitionFast) opacity,
			var(--transitionFast) translate,
			var(--transitionFast) visibility;
	}

	.clear:not([data-active]) {
		opacity: 0;
		translate: 0 0.5rem;
		visibility: hidden;
	}

	.clear :global(svg) {
		display: block;
		overflow: visible;
		stroke: currentColor;
		stroke-width: 0.75px;
	}

	/*
	 * Shows whichever of its icons, if it has many, its script hasn't marked as being out.
	 * While it's been used, changing between them has icons orbit in and out.
	 */
	.icons {
		display: block;
		height: 2rem;
		mask-image: linear-gradient(black 70%, transparent 95%);
		position: relative;
		width: 100%;
	}

	.icons :global(svg) {
		animation-duration: var(--transitionSlow);
		animation-fill-mode: both;
		animation-timing-function: ease;
		height: 1.25rem;
		inset: 0 0 0 auto;
		margin: auto 0;
		position: absolute;
		transform-origin: 50% 1.75rem;
		width: 1.25rem;
	}

	.icons :global([data-out]) {
		opacity: 0;
		transform: rotate(90deg);
	}

	.header-toggle[data-used] :global([data-out]) {
		animation-name: orbit-out;
	}

	.header-toggle[data-used] .icons :global([data-state]:not([data-out])) {
		animation-delay: calc(var(--transitionSlow) / 2);
		animation-name: orbit-in;
	}

	@keyframes orbit-in {
		from {
			opacity: 0;
			transform: rotate(-90deg);
		}
		to {
			opacity: 1;
			transform: rotate(0deg);
		}
	}

	@keyframes orbit-out {
		from {
			opacity: 1;
			transform: rotate(0deg);
		}
		to {
			opacity: 0;
			transform: rotate(90deg);
		}
	}
</style>
