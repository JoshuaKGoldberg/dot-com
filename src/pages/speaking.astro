---
import { getCollection } from "astro:content";

import halo from "~/assets/heroes/speaking-halo.webp";
import scene from "~/assets/heroes/speaking-scene.webp";
import image from "~/assets/heroes/speaking.webp";
import { Anchor } from "~/components/Anchor";
import BodyContents from "~/components/BodyContents.astro";
import { SpeakingsTabbed } from "~/components/speaking/SpeakingsTabbed";

import { speakingDescription } from "../constants";
import HeroLayout from "../layouts/HeroLayout.astro";

const speakings = (await getCollection("speaking")).map(({ data }) => data);
---

<HeroLayout
	alt="Josh mid-sentence on stage under green lights, wearing a headset microphone and a light patterned shirt"
	description={speakingDescription}
	portrait={{ halo, image, scene }}
	primary="Speaking"
	title="Speaking"
>
	<!-- prettier-ignore -->
	<Fragment slot="secondary">
		I talk about static analysis and co-organize <Anchor href="https://squiggleconf.com" target="_blank">SquiggleConf</Anchor>.
	</Fragment>
	<BodyContents>
		<SpeakingsTabbed client:load now={Date.now()} speakings={speakings} />
	</BodyContents>
</HeroLayout>
