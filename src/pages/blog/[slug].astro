---
import { type CollectionEntry, getCollection, render } from "astro:content";

import BlogContent from "~/components/blog/BlogContent.astro";
import BlogHero from "~/components/blog/BlogHero.astro";
import BlogShareBottom from "~/components/blog/BlogShareBottom.astro";
import { TableOfContents } from "~/components/blog/TableOfContents";
import {
	createBlogDescription,
	createBlogTitle,
	getReadingMinutes,
} from "~/components/blog/utils";
import BodyContents from "~/components/BodyContents.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getPostPicture } from "~/previews/getPostPicture";

interface Props {
	entry: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
	const blogs = await getCollection("blog");

	return blogs.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const blogs = await getCollection("blog");
const description = createBlogDescription(entry);
const rendered = await render(entry);
const title = createBlogTitle(entry);
---

<BaseLayout
	description={description}
	preview={{
		alt: `${title}: ${getPostPicture(entry).alt}`,
		name: `blog/${entry.id}`,
	}}
	published={entry.data.pubDate}
	shortTitle={title}
	tags={entry.data.tags}
	title={`${title} | Goldblog`}
>
	<BodyContents class="top">
		<BlogHero
			date={entry.data.pubDate}
			description={entry.data.description}
			download={entry.data.download}
			image={entry.data.image}
			minutes={getReadingMinutes(entry.body)}
			title={entry.data.title}
		/>
		<TableOfContents client:idle headings={rendered.headings} />
	</BodyContents>
	<BlogContent
		rendered={rendered}
		series={
			entry.data.series
				? {
						entries: blogs.filter(
							(blog) => blog.data.series === entry.data.series,
						),
						entry,
						series: entry.data.series,
					}
				: undefined
		}
	>
		<BlogShareBottom description={description} title={title} url={Astro.url} />
	</BlogContent>
</BaseLayout>

<style>
	.top {
		margin-top: 1.5rem;
	}

	.top::after {
		border-bottom: 1px solid var(--colorMedium);
		content: "";
		display: block;
		margin-bottom: 2.5rem;
		width: 100%;
	}

	@media (width >= 43.75em) {
		.top {
			margin-top: var(--heightMinimumFromHeader);
		}

		.top::after {
			margin-bottom: 3rem;
		}
	}

	@media (width >= 63.5625em) {
		.top::after {
			margin: 2rem 0;
			width: calc(100% - var(--widthTableOfContents));
		}
	}
</style>
