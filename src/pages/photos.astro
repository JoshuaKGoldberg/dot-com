---
import BodyContents from "~/components/BodyContents.astro";
import HeroTertiary from "~/components/HeroTertiary.astro";
import PhotoGallery from "~/components/photos/PhotoGallery.astro";
import { photos } from "~/photos";
import { extraPreviews } from "~/previews/extraPreviews";

import { photosDescription } from "../constants";
import HeroLayout from "../layouts/HeroLayout.astro";
---

<HeroLayout
	description={photosDescription}
	portrait={extraPreviews.photos.portrait}
	preview="photos"
	primary="Photos"
	title="Photos"
>
	<Fragment slot="secondary">{photosDescription}</Fragment>
	<HeroTertiary slot="tertiary">
		Click a photo to open its original.
		<br />
		If you use one, please credit its photographer.
	</HeroTertiary>

	<BodyContents>
		<PhotoGallery photos={photos} />
	</BodyContents>
</HeroLayout>
