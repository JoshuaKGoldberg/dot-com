---
import halo from "~/assets/heroes/home-halo.webp";
import image from "~/assets/heroes/home.webp";
import { Anchor } from "~/components/Anchor";
import BodyContents from "~/components/BodyContents.astro";
import Socials from "~/components/Socials.astro";
import { Text } from "~/components/Text";

import HeroLayout from "../layouts/HeroLayout.astro";
---

<HeroLayout
	alt="Josh looking calmly at the camera from inside a purple hood with big ears and a triangular antenna"
	description="I work to make web development better, most notably on typescript-eslint. Author of Learning TypeScript, speaker, SquiggleConf co-founder, and dev at Sentry."
	fitsScreen
	portrait={{ halo, image }}
	primary="Hello. I’m Josh."
	size="large"
	slug="josh"
>
	<Fragment slot="secondary">I’m good at TypeScript.</Fragment>
	<Socials slot="tertiary" />
	<BodyContents class="about">
		<!-- prettier-ignore -->
		<Text as="p" fontSize="medium" fontWeight="light">
			I work to make web development better, most notably on <Anchor href="https://typescript-eslint.io" target="_blank">typescript-eslint</Anchor>:
			<br class="tabletUp" />a powerful static analysis toolset for JavaScript
			and TypeScript code.
		</Text>
		<!-- prettier-ignore -->
		<Text as="p" fontSize="medium" fontWeight="light">
			I’m the author of <cite>Learning TypeScript</cite> (O’Reilly), a Microsoft MVP,
			<br class="tabletUp" />
			a keynote speaker, a <Anchor href="https://squiggleconf.com" target="_blank">SquiggleConf</Anchor> co-founder, and a dev at <Anchor href="https://sentry.io" target="_blank">Sentry</Anchor>.
		</Text>
	</BodyContents>
</HeroLayout>

<style>
	.tabletUp {
		display: none;
	}

	.about {
		--squiggleOffset: -0.36em;

		display: flex;
		gap: clamp(1vh, 1.5rem, 3vh);
		flex-direction: column;
		grid-row: 4;
		line-height: 1.35;
		margin-top: clamp(1rem, 20dvh - 7.5rem, 3rem);
	}

	@media (max-height: 700px) and (max-width: 699px) {
		.about :global(p) {
			font-size: var(--fontSizeSmall);
		}
	}

	@media (min-width: 700px) {
		.tabletUp {
			display: block;
		}

		.about {
			margin-top: clamp(0.5rem, 2vh, 1.5rem);
			text-align: center;
		}
	}
</style>
