---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";

import halo from "~/assets/heroes/blog-halo.webp";
import scene from "~/assets/heroes/blog-scene.webp";
import image from "~/assets/heroes/blog.webp";
import { Anchor } from "~/components/Anchor";
import { BlogsGrouped } from "~/components/blog/BlogsGrouped";
import {
	createBlogDescription,
	createBlogTitle,
	getReadingMinutes,
} from "~/components/blog/utils";
import BodyContents from "~/components/BodyContents.astro";
import { largestEntryImagePixels } from "~/components/entries/ContentEntryImage";
import HeroTertiary from "~/components/HeroTertiary.astro";

import { blogDescription } from "../constants";
import HeroLayout from "../layouts/HeroLayout.astro";

const thumbnailDensity = 2;
const thumbnailSize = largestEntryImagePixels * thumbnailDensity;

const blogs = await Promise.all(
	(await getCollection("blog"))
		.sort((a, b) => +b.data.pubDate - +a.data.pubDate)
		.map(async (blog) => ({
			date: blog.data.pubDate,
			description: createBlogDescription(blog),
			id: blog.id,
			image: {
				alt: blog.data.image.alt,
				src: (
					await getImage({
						fit: "cover",
						height: thumbnailSize,
						src: blog.data.image.src,
						width: thumbnailSize,
					})
				).src,
			},
			minutes: getReadingMinutes(blog.body),
			title: createBlogTitle(blog),
		})),
);
---

<HeroLayout
	alt="Josh speaking excitedly into a microphone while wearing a shiny silver space suit"
	description={blogDescription}
	portrait={{ halo, image, scene }}
	primary="Goldblog"
	title="Goldblog"
>
	<Fragment slot="secondary">{blogDescription}</Fragment>
	<!-- prettier-ignore -->
	<HeroTertiary slot="tertiary">
		New posts are shared online and posted to an RSS feed at <Anchor href="/rss.xml" target="_blank">/rss.xml</Anchor>.
	</HeroTertiary>

	<BodyContents>
		<BlogsGrouped blogs={blogs} />
	</BodyContents>
</HeroLayout>
