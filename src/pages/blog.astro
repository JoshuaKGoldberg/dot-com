---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";

import goldblogDark from "~/assets/goldblog-dark.webp";
import goldblogLight from "~/assets/goldblog-light.webp";
import { Anchor } from "~/components/Anchor";
import { BlogsGrouped } from "~/components/blog/BlogsGrouped";
import { createBlogTitle, getReadingMinutes } from "~/components/blog/utils";
import BodyContents from "~/components/BodyContents.astro";
import HeroTertiary from "~/components/HeroTertiary.astro";

import { blogDescription } from "../constants";
import HeroLayout from "../layouts/HeroLayout.astro";

// Twice ContentEntryImage's largest size, for high-density screens
const thumbnailSize = 160;

const blogs = await Promise.all(
	(await getCollection("blog"))
		.sort((a, b) => +b.data.pubDate - +a.data.pubDate)
		.map(async (blog) => ({
			date: blog.data.pubDate,
			description: blog.data.description,
			id: blog.id,
			image: {
				alt: blog.data.image.alt,
				src: (
					await getImage({
						fit: "cover",
						height: thumbnailSize,
						src: blog.data.image.src,
						width: thumbnailSize,
					})
				).src,
			},
			minutes: getReadingMinutes(blog.body),
			title: createBlogTitle(blog),
		})),
);
---

<HeroLayout
	alt="Smiling cat receiving head scratches next to a laptop showing VS Code"
	description={blogDescription}
	images={{ dark: goldblogDark, light: goldblogLight }}
	preview="images/goldblog-preview.png"
	primary="Goldblog"
	title="Goldblog"
>
	<Fragment slot="secondary">{blogDescription}</Fragment>
	<HeroTertiary slot="tertiary">
		New posts are shared online and posted to an RSS feed at{" "}
		<Anchor href="/rss.xml" target="_blank">
			/rss.xml
		</Anchor>
		.
	</HeroTertiary>

	<BodyContents>
		<BlogsGrouped blogs={blogs} />
	</BodyContents>
</HeroLayout>
