{
	"compilerOptions": {
		"exactOptionalPropertyTypes": false,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"moduleResolution": "Bundler",
		"noUncheckedIndexedAccess": false,
		"paths": {
			"~/*": ["./src/*"]
		},
		"target": "es2022"
	},
	"exclude": ["dist", "worker"],
	"extends": "astro/tsconfigs/strictest"
}
